{% extends "layout/app.twig" %}

{% block title %}{{ page_title|default(lang.panel_title|default('User Panel')) }} - {{ parent() }}{% endblock %}

{% block content %}
    <h3 class="head-title">{{ page_title|default(lang.panel_heading|default('User Panel')) }}</h3>

    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ baseurl_root|default('/') }}"><i class="fa fa-home"></i> {{ lang.breadcrumb_home|default('Home') }}</a></li>
        <li class="breadcrumb-item active" aria-current="page">{{ lang.breadcrumb_panel|default('Panel') }}</li>
    </ol>

    <p class="mt-3 mb-3">
        <a class="btn btn-primary btn-sm" href="{{ baseurl_root }}/panel/create_site"> {# Changed to btn-primary #}
            <i class="fa fa-plus me-2"></i>{{ lang.create_new_site_button|default('Membuat situs baru') }}
        </a>
    </p>

    {% if sites is not empty %}
        <div class="row row-cols-1 row-cols-md-2 g-4"> {# Using Bootstrap cards and grid for site listing #}
            {% for site_item in sites %}
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">
                                <a href="//{{ site_item.url|e }}" target="_blank">
                                    <i class="fa fa-globe fa-fw me-2"></i>{{ site_item.url|e }}
                                </a>
                            </h5>
                            <p class="card-text">
                                <small class="text-muted">{{ lang.site_created_label|default('Dibuat') }}: {{ site_item.time_formatted }}</small>
                            </p>
                        </div>
                        <div class="card-footer bg-transparent border-top-0">
                             <a href="{{ baseurl_root }}/panel/switch/id/{{ site_item.site_id }}" class="btn btn-sm btn-outline-primary me-2">
                                <i class="fa fa-sign-in fa-fw me-1"></i>{{ lang.manage_site_button|default('Kelola') }}
                            </a>
                            <a href="{{ baseurl_root }}/panel/delete_site/id/{{ site_item.site_id }}" class="btn btn-sm btn-outline-danger">
                                <i class="fa fa-times fa-fw me-1"></i>{{ lang.delete_site_button|default('Hapus') }}
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-info mt-3">{{ lang.no_sites_message|default('Kamu belum memiliki situs.') }}</div>
    {% endif %}
{% endblock %}
