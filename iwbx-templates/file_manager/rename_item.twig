{% extends "layout/app.twig" %}

{% block title %}{{ page_title|default(lang.rename_title|default('Ubah Nama')) }} - {{ item_name|e }} - {{ parent() }}{% endblock %}

{% block content %}
    <h3 class="head-title">{{ page_title|default(lang.rename_heading|default('Ubah Nama')) }}: {{ item_name|e }}</h3>

    <ol class="breadcrumb">
        <li><a href="{{ baseurl_root }}/panel/dashboard"><i class="fa fa-dashboard"></i> {{ lang.breadcrumb_dashboard|default('Dashboard') }} ({{ site.url|e }})</a></li>
        <li><a href="{{ base_fm_url }}"><i class="fa fa-folder-open"></i> {{ lang.breadcrumb_file_manager_root|default('File Manager') }}</a></li>
        {% for segment in breadcrumb_segments %}
            <li><a href="{{ segment.url|e('html_attr') }}">{{ segment.name|e }}</a></li>
        {% endfor %}
        <li class="active">{{ item_name|e }} ({{ lang.rename_breadcrumb|default('Ubah Nama') }})</li>
    </ol>

    {% if error_message %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ error_message|e }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endif %}

    <div class="row justify-content-center mt-3">
        <div class="col-md-8 col-lg-6">
            <form role="form" action="{{ form_action_url|e('html_attr') }}" method="post" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="new_item_name" class="form-label">
                        {% if item_type == 'dir' %}
                            {{ lang.new_folder_name_label|default('Nama Folder Baru') }}
                        {% else %}
                            {{ lang.new_file_name_label|default('Nama File Baru') }}
                        {% endif %}
                    </label>
                    <input class="form-control form-control-sm {% if error_message %}is-invalid{% endif %}" type="text" name="new_item_name" id="new_item_name" value="{{ current_name_value|e('html_attr') }}" required pattern="^[a-zA-Z0-9._-]+$" title="{{ lang.valid_chars_message|default('Karakter yang diijinkan: a-z, A-Z, 0-9, ., _, -') }}"/>
                    {# Note: error_message is general here, not field-specific from PHP. For field-specific, PHP would need to pass errors keyed by field name. #}
                    {% if error_message %}<div class="invalid-feedback">{{ error_message }}</div>{% endif %}
                    <div class="form-text">{{ lang.valid_chars_message|default('Karakter yang diijinkan: a-z, A-Z, 0-9, ., _, -') }}</div>
                </div>
                <div class="mt-4">
                    <button class="btn btn-primary btn-sm" type="submit" name="submit_rename"><i class="fa fa-save me-1"></i> {{ lang.save_button|default('Simpan') }}</button>
                    <a class="btn btn-secondary btn-sm ms-2" href="{{ cancel_url|e('html_attr') }}"><i class="fa fa-times me-1"></i> {{ lang.cancel_button|default('Batal') }}</a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
