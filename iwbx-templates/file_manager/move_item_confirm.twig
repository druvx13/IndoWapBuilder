{% extends "layout/app.twig" %}

{% block title %}{{ page_title|default(lang.move_item_title|default('Pindahkan Item')) }} - {{ parent() }}{% endblock %}

{% block content %}
    <h3 class="head-title">{{ page_title|default(lang.move_item_heading|default('Konfirmasi Pemindahan Item')) }}</h3>

    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ baseurl_root }}/panel/dashboard"><i class="fa fa-dashboard"></i> {{ lang.breadcrumb_dashboard|default('Dashboard') }} ({{ site.url|e }})</a></li>
        <li class="breadcrumb-item"><a href="{{ base_fm_url }}"><i class="fa fa-folder-open"></i> {{ lang.breadcrumb_file_manager_root|default('File Manager') }}</a></li>
        {% for segment in breadcrumb_segments %} {# Segments for the target directory #}
            <li class="breadcrumb-item"><a href="{{ segment.url|e('html_attr') }}">{{ segment.name|e }}</a></li>
        {% endfor %}
        <li class="breadcrumb-item active" aria-current="page">{{ lang.move_breadcrumb|default('Pindahkan Item') }}</li>
    </ol>

    <div class="row justify-content-center mt-3">
        <div class="col-md-8 col-lg-6">
            {% if error_message %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ error_message|e }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endif %}

            {% if item_to_move_name and target_dir_display %}
                <div class="card shadow-sm">
                    <div class="card-body">
                        <form method="post" action="{{ form_action_url|e('html_attr') }}">
                            <input type="hidden" name="item_to_move" value="{{ item_to_move_path|e('html_attr') }}">
                            <input type="hidden" name="target_dir" value="{{ target_dir_path|e('html_attr') }}">

                            <div class="alert alert-warning" role="alert">
                                <h4 class="alert-heading">{{ lang.confirm_move_heading|default('Konfirmasi Pemindahan') }}</h4>
                                <p>
                                {{ lang.confirm_move_message|default('Apa kamu yakin akan memindahkan <strong>%item_name%</strong> ke folder <strong>%target_folder%</strong>?')
                                    |replace({'%item_name%': item_to_move_name|e, '%target_folder%': target_dir_display|e})
                                    |raw
                                }}
                                </p>
                            </div>
                            <div class="mt-3 text-center">
                                <button class="btn btn-primary btn-sm" type="submit" name="submit_move_confirm"><i class="fa fa-check me-1"></i> {{ lang.yes_move_button|default('Ya, Pindahkan') }}</button>
                                <a class="btn btn-secondary btn-sm ms-2" href="{{ cancel_url|e('html_attr') }}"><i class="fa fa-times me-1"></i> {{ lang.cancel_button|default('Batal') }}</a>
                            </div>
                        </form>
                    </div>
                </div>
            {% else %}
                 <div class="alert alert-danger" role="alert">
                    {{ lang.move_parameters_missing|default('Parameter untuk pemindahan item tidak lengkap atau item tidak ditemukan.') }}
                 </div>
                 <div class="mt-3">
                    <a class="btn btn-secondary btn-sm" href="{{ base_fm_url }}"><i class="fa fa-arrow-left me-2"></i>{{ lang.back_to_fm_button|default('Kembali ke File Manager') }}</a>
                 </div>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
