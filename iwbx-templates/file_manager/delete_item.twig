{% extends "layout/app.twig" %}

{% block title %}{{ page_title|default(lang.delete_title|default('Hapus Item')) }} - {{ item_name|e }} - {{ parent() }}{% endblock %}

{% block content %}
    <h3 class="head-title">{{ page_title|default(lang.delete_heading|default('Hapus Item')) }}: {{ item_name|e }}</h3>

    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ baseurl_root }}/panel/dashboard"><i class="fa fa-dashboard"></i> {{ lang.breadcrumb_dashboard|default('Dashboard') }} ({{ site.url|e }})</a></li>
        <li class="breadcrumb-item"><a href="{{ base_fm_url }}"><i class="fa fa-folder-open"></i> {{ lang.breadcrumb_file_manager_root|default('File Manager') }}</a></li>
        {% for segment in breadcrumb_segments %}
            <li class="breadcrumb-item"><a href="{{ segment.url|e('html_attr') }}">{{ segment.name|e }}</a></li>
        {% endfor %}
        <li class="breadcrumb-item active" aria-current="page">{{ item_name|e }} ({{ lang.delete_breadcrumb|default('Hapus') }})</li>
    </ol>

    <div class="row justify-content-center mt-3">
        <div class="col-md-8 col-lg-6">
            <form role="form" action="{{ form_action_url|e('html_attr') }}" method="post">
                <div class="alert alert-warning" role="alert">
                    <h4 class="alert-heading">{{ lang.confirm_delete_heading|default('Konfirmasi Hapus') }}</h4>
                    <p>
                        {% if item_type == 'dir' %}
                            {{ lang.confirm_delete_folder_message|default('Apakah Kamu yakin akan menghapus folder <strong>%item_name%</strong> beserta seluruh isinya?')|replace({'%item_name%': item_name|e})|raw }}
                        {% else %}
                            {{ lang.confirm_delete_file_message|default('Apakah Kamu yakin akan menghapus file <strong>%item_name%</strong>?')|replace({'%item_name%': item_name|e})|raw }}
                        {% endif %}
                    </p>
                    <hr>
                    <p class="mb-0">{{ lang.action_cannot_be_undone|default('Tindakan ini tidak dapat dibatalkan.') }}</p>
                </div>
                <div class="mt-3">
                    <button class="btn btn-danger btn-sm" type="submit" name="submit_delete"><i class="fa fa-trash me-1"></i> {{ lang.yes_delete_button|default('Ya, Hapus') }}</button>
                    <a class="btn btn-secondary btn-sm ms-2" href="{{ cancel_url|e('html_attr') }}"><i class="fa fa-times me-1"></i> {{ lang.cancel_button|default('Batal') }}</a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
