{% extends "layout/app.twig" %}

{% block title %}{{ page_title|default(lang.change_password_title|default('Ubah Kata Sandi')) }} - {{ parent() }}{% endblock %}

{% block content %}
    <h3 class="head-title">{{ page_title|default(lang.change_password_heading|default('Ubah Kata Sandi')) }}</h3>

    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ baseurl_root|default('/') }}"><i class="fa fa-home"></i> {{ lang.breadcrumb_home|default('Home') }}</a></li>
        <li class="breadcrumb-item"><a href="{{ baseurl_root }}/account">{{ lang.breadcrumb_account|default('Akun') }}</a></li>
        <li class="breadcrumb-item active" aria-current="page">{{ lang.breadcrumb_change_password|default('Ubah Kata Sandi') }}</li>
    </ol>

    {% if errors.general %}
         <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ errors.general }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endif %}

    <div class="row justify-content-center">
        <div class="col-md-6"> {# Centered form container #}
            <form action="{{ form_action_url|e('html_attr') }}" method="post" class="mt-3 needs-validation" novalidate>
                <div class="mb-3">
                    <label for="pass" class="form-label">{{ lang.current_password_label|default('Kata sandi sekarang') }}</label>
                    <input class="form-control form-control-sm {% if errors.pass %}is-invalid{% endif %}" id="pass" type="password" name="pass" value="" required/>
                    {% if errors.pass %}<div class="invalid-feedback">{{ errors.pass }}</div>{% endif %}
                </div>

                <div class="mb-3">
                    <label for="pass1" class="form-label">{{ lang.new_password_label|default('Kata sandi baru') }}</label>
                    <input class="form-control form-control-sm {% if errors.pass1 %}is-invalid{% endif %}" id="pass1" type="password" name="pass1" value="" required/>
                    {% if errors.pass1 %}<div class="invalid-feedback">{{ errors.pass1 }}</div>{% endif %}
                </div>

                <div class="mb-3">
                    <label for="pass2" class="form-label">{{ lang.repeat_new_password_label|default('Ulangi Kata sandi baru') }}</label>
                    <input class="form-control form-control-sm {% if errors.pass2 %}is-invalid{% endif %}" id="pass2" type="password" name="pass2" value="" required/>
                    {% if errors.pass2 %}<div class="invalid-feedback">{{ errors.pass2 }}</div>{% endif %}
                </div>

                <div class="d-grid mt-4">
                    <button class="btn btn-primary btn-sm" type="submit" name="submit">{{ lang.save_button|default('Simpan') }}</button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
