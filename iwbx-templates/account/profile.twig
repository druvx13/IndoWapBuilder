{% extends "layout/app.twig" %}

{% block title %}{{ page_title|default(lang.edit_profile_title|default('Edit Profil')) }} - {{ parent() }}{% endblock %}

{% block content %}
    <h3 class="head-title">{{ page_title|default(lang.edit_profile_heading|default('Edit Profil')) }}</h3>

    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ baseurl_root|default('/') }}"><i class="fa fa-home"></i> {{ lang.breadcrumb_home|default('Home') }}</a></li>
        <li class="breadcrumb-item"><a href="{{ baseurl_root }}/account">{{ lang.breadcrumb_account|default('Akun') }}</a></li>
        <li class="breadcrumb-item active" aria-current="page">{{ lang.breadcrumb_edit_profile|default('Edit Profil') }}</li>
    </ol>

    {# Display general form errors if any #}
    {% if errors.general %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ errors.general }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endif %}

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6"> {# Centered form container #}
            <form action="{{ form_action_url|e('html_attr') }}" method="post" class="mt-3 needs-validation" novalidate>
                <div class="mb-3">
                    <label for="author" class="form-label">{{ lang.name_label|default('Nama') }}</label>
                    <input class="form-control form-control-sm {% if errors.author %}is-invalid{% endif %}" id="author" type="text" name="author" value="{{ form_values.author|e('html_attr') }}" required/>
                    {% if errors.author %}<div class="invalid-feedback">{{ errors.author }}</div>{% endif %}
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">{{ lang.email_label|default('Email') }}</label>
                    <input class="form-control form-control-sm {% if errors.email %}is-invalid{% endif %}" id="email" type="email" name="email" value="{{ form_values.email|e('html_attr') }}" required/>
                    {% if errors.email %}<div class="invalid-feedback">{{ errors.email }}</div>{% endif %}
                    <div class="form-text">{{ lang.email_help|default('Harap memasukan alamat email dengan benar, ini digunakan jika Kamu lupa kata sandi') }}</div>
                </div>

                <div class="mb-3">
                    <label for="gender" class="form-label">{{ lang.gender_label|default('Jenis kelamin') }}</label>
                    <select class="form-select form-select-sm {% if errors.gender %}is-invalid{% endif %}" id="gender" name="gender">
                        <option value="male" {% if form_values.gender == 'male' %}selected{% endif %}>{{ lang.gender_male|default('Laki-laki') }}</option>
                        <option value="female" {% if form_values.gender == 'female' %}selected{% endif %}>{{ lang.gender_female|default('Perempuan') }}</option>
                    </select>
                    {% if errors.gender %}<div class="invalid-feedback">{{ errors.gender }}</div>{% endif %}
                </div>

                <div class="mt-4">
                    <button class="btn btn-primary btn-sm" type="submit" name="submit">{{ lang.save_button|default('Simpan') }}</button>
                    <a class="btn btn-secondary btn-sm ms-2" href="{{ form_action_url|e('html_attr') }}">{{ lang.reset_button|default('Reset form') }}</a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
