{% extends "layout/app.twig" %}

{% block title %}{{ page_title|default(lang.reset_password_title|default('Reset Password')) }} - {{ parent() }}{% endblock %}

{% block content %}
    <h3 class="head-title">{{ page_title|default(lang.reset_password_heading|default('Setel ulang kata sandi')) }}</h3>

    {# Display general form errors if any (e.g. "Kode konfirmasi tidak benar!") #}
    {% if error_message %} {# From Func::displayError in original PHP, potentially HTML #}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ error_message|raw }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endif %}

    {# More structured errors passed from controller #}
    {% if errors.general %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ errors.general }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endif %}

    <div class="row justify-content-center">
      <div class="col-md-6"> {# Adjust column width as needed #}
        <form action="{{ form_action_url|e('html_attr') }}" method="post" class="mt-4">
            <div class="mb-3">
                <label for="pass1" class="form-label">{{ lang.new_password_label|default('Kata sandi baru') }}</label>
                <input class="form-control form-control-sm {% if errors.pass1 %}is-invalid{% endif %}" id="pass1" type="password" name="pass1" value="" required/>
                {% if errors.pass1 %}<div class="invalid-feedback">{{ errors.pass1 }}</div>{% endif %}
            </div>
            <div class="mb-3">
                <label for="pass2" class="form-label">{{ lang.repeat_new_password_label|default('Ulangi Kata sandi baru') }}</label>
                <input class="form-control form-control-sm {% if errors.pass2 %}is-invalid{% endif %}" id="pass2" type="password" name="pass2" value="" required/>
                {% if errors.pass2 %}<div class="invalid-feedback">{{ errors.pass2 }}</div>{% endif %}
            </div>
            <div class="d-grid gap-2">
                <button class="btn btn-primary btn-sm" type="submit" name="submit">{{ lang.save_button|default('Simpan') }}</button>
            </div>
        </form>
      </div>
    </div>
{% endblock %}
