{% extends "layout/app.twig" %}

{% block title %}{{ page_title|default(lang.forgot_password_title|default('Forgot Password')) }} - {{ parent() }}{% endblock %}

{% block content %}
    <h3 class="head-title">{{ page_title|default(lang.forgot_password_heading|default('Lupa Kata sandi')) }}</h3>

    {% if error_message %} {# For single error string as in original PHP #}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ error_message|e }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endif %}
    {# Session notice is handled by layout/app.twig #}

    <div class="row justify-content-center">
      <div class="col-md-6"> {# Adjust column width as needed #}
        <form role="form" action="{{ form_action_url|e('html_attr') }}" method="post" class="mt-4">
            <div class="mb-3">
                <label for="email" class="form-label">{{ lang.email_label|default('Email') }}</label>
                <input class="form-control form-control-sm {% if errors.email %}is-invalid{% endif %}" id="email" type="email" name="email" value="{{ email_value|e('html_attr') }}" required/>
                {% if errors.email %}<div class="invalid-feedback">{{ errors.email }}</div>{% endif %} {# For structured errors if implemented #}
            </div>
            <div class="d-grid gap-2">
                <button class="btn btn-primary btn-sm" type="submit" name="submit">{{ lang.send_button|default('Kirim') }}</button>
            </div>
        </form>
      </div>
    </div>
{% endblock %}
